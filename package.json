{
  "name": "arm-design",
  "version": "0.1.0",
  "private": true,
  "description": "Codex-friendly tooling wrapper for the Huashu Design HTML-native design skill.",
  "scripts": {
    "doctor": "node .agents/skills/arm-design/scripts/doctor.mjs --json",
    "playwright:install": "playwright install chromium",
    "verify:setup": "python3 -m pip install -r requirements.txt && python3 -m playwright install chromium",
    "verify": "python3 scripts/verify.py",
    "verify:json": "node .agents/skills/arm-design/scripts/verify.mjs",
    "smoke": "python3 scripts/verify.py demos/c1-ios-prototype-en.html --output /tmp/arm-design-smoke --viewports 1440x900 --wait 1000",
    "smoke:json": "node .agents/skills/arm-design/scripts/verify.mjs --input .agents/skills/arm-design/fixtures/simple.html --out /tmp/arm-design-verify --json",
    "render-video": "node scripts/render-video.js",
    "formats": "bash scripts/convert-formats.sh",
    "music": "bash scripts/add-music.sh",
    "deck:pdf": "node scripts/export_deck_pdf.mjs",
    "deck:stage-pdf": "node scripts/export_deck_stage_pdf.mjs",
    "deck:pptx": "node scripts/export_deck_pptx.mjs"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "^1.52.0",
    "pptxgenjs": "^3.12.0",
    "sharp": "^0.33.5"
  }
}
